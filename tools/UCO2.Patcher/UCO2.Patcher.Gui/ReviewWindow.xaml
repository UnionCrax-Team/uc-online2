<Window x:Class="UCO2.Patcher.Gui.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review patch" Width="900" Height="720" MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Text="Review patch" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Nothing is changed until you confirm" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="10,4">
                    <TextBlock x:Name="ChangeCountText" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource WindowBrush}">
            <StackPanel Margin="20,16,20,22">
                <TextBlock Text="TARGET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="GameValue" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrightBrush}" />
                        <TextBlock x:Name="FolderValue" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,12" TextWrapping="Wrap" />
                        <WrapPanel>
                            <StackPanel Width="195" Margin="0,0,10,6">
                                <TextBlock Text="DETECTED" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="DetectedValue" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Width="145" Margin="0,0,10,6">
                                <TextBlock Text="GAME APPID" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="GameAppIdValue" Margin="0,3,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Width="145" Margin="0,0,10,6">
                                <TextBlock Text="EMULATED APPID" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="EmulatedAppIdValue" Margin="0,3,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,8">
                    <TextBlock Text="SELECTED FIXES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="EnabledCountText" HorizontalAlignment="Right" Foreground="{StaticResource FaintBrush}" />
                </Grid>
                <ItemsControl x:Name="EnabledSettingsList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Margin="0,0,7,7" Padding="9,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" Background="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DisabledSettingsText" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />

                <Border x:Name="WarningsPanel" Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1" Padding="12,10" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="WARNINGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,7" />
                        <ItemsControl x:Name="WarningsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="NoWarningsPanel" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" Background="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="No warnings detected" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,8">
                    <TextBlock Text="FILE CHANGES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Existing files are backed up first" HorizontalAlignment="Right" Foreground="{StaticResource FaintBrush}" />
                </Grid>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource FieldBrush}">
                    <StackPanel>
                        <Grid Background="{StaticResource PanelBrush}" Height="32">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ACTION" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="CHANGE" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="DESTINATION" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" FontSize="10" FontWeight="Bold" />
                        </Grid>
                        <ItemsControl x:Name="ChangesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="10,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="102" /><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Action}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" Margin="10,0,14,0" />
                                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrightBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Directory}" Foreground="{StaticResource FaintBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="FooterText" Text="Review the summary before continuing" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" />
                    <Button x:Name="ConfirmButton" Content="Back up and apply" MinWidth="150" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
